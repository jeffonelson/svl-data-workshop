#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/workshop-common.sh
source "$repo_root/bin/lib/workshop-common.sh"
workshop_load_config

if ! command -v codex >/dev/null 2>&1; then
  echo "Missing required command: codex" >&2
  exit 1
fi

workshop_prepare_launch
echo "Launching Codex for project: $WORKSHOP_PROJECT_ID"

cd "$repo_root"
exec codex "$@"
